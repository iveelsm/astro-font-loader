---
import { getFontsPackageInfo, getAvailableFonts } from '../src/fonts/index.ts';
import { createVariantFilter } from '../src/fonts/filter.ts';
import { getFontsCss } from '../src/css/get.ts';
import type { FontVariant, FontSource } from '../src/types.ts';

interface Props {
	/** The font variant to load. */
	variant: FontVariant;
	/** The source provider for this font. */
	source: FontSource;
	/** Font family name. */
	family: string;
	/** Output directory name used in generated font URLs. */
	outputDirectory: string;
	/** What to render: "all" (default), "css" (style only), or "preload" (link tags only). */
	mode?: "all" | "css" | "preload";
	/** Optional media query for preload links. */
	media?: string;
	/** Root directory to resolve font packages from. Defaults to process.cwd(). */
	root?: string;
}

const MIME_TYPES: Record<string, string> = {
	woff2: 'font/woff2',
	woff: 'font/woff',
	ttf: 'font/ttf',
	otf: 'font/otf',
	eot: 'application/vnd.ms-fontobject',
};

function getMimeType(filename: string): string {
	const ext = filename.split('.').pop()?.toLowerCase() ?? '';
	return MIME_TYPES[ext] ?? 'font/woff2';
}

const {
	variant,
	source,
	family,
	outputDirectory,
	mode = "all",
	media,
	root = process.cwd(),
} = Astro.props;

const fontConfig = { family, source, variants: [variant] };

let css = '';
const preloadHrefs: Array<{ href: string; type: string }> = [];

const packageInfo = getFontsPackageInfo(source.package, root, source.styleFile);

if (packageInfo) {
	const filter = createVariantFilter(fontConfig);

	if (mode !== "preload") {
		css = getFontsCss({ filter, outputDirectory }, packageInfo);
	}

	if (mode !== "css") {
		let matchedFonts = getAvailableFonts(packageInfo.fontsDir);
		matchedFonts = matchedFonts.filter((f) => filter(f.filename));
		for (const f of matchedFonts) {
			preloadHrefs.push({
				href: `/${outputDirectory}/${f.filename}`,
				type: getMimeType(f.filename),
			});
		}
	}
}
---

{preloadHrefs.map(({ href, type }) => (
	<link rel="preload" as="font" crossorigin href={href} type={type} media={media} />
))}
{css && <style set:html={css} is:inline />}
